HTML
<!DOCTYPE html>
<html>
<head>
    <title>NovaLoop Driving Car</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>
    <div class="game">
        <div id="road"></div>
        <div id="car"></div>
        <div id="obstacle"></div>
        <div id="score">Score: 0</div>
    </div>

    <script src="script.js"></script>
</body>
</html>












CSS
body{
    margin:0;
    display:flex;
    justify-content:center;
    background:#222;
}

.game{
    position:relative;
    width:300px;
    height:600px;
    background:#555;
    overflow:hidden;
    border:4px solid white;
}

#road{
    position:absolute;
    width:100%;
    height:100%;
    background:repeating-linear-gradient(
        #555 0px,
        #555 40px,
        white 40px,
        white 50px
    );
    animation:roadMove 1s linear infinite;
}

@keyframes roadMove{
    from{background-position-y:0;}
    to{background-position-y:50px;}
}

#car{
    position:absolute;
    width:50px;
    height:90px;
    background:red;
    bottom:20px;
    left:125px;
    border-radius:10px;
}

#obstacle{
    position:absolute;
    width:50px;
    height:90px;
    background:blue;
    top:-100px;
    left:120px;
}

#score{
    position:absolute;
    top:10px;
    left:10px;
    color:white;
    font-size:20px;
    font-family:Arial;
}











JavaScript
const car = document.getElementById("car");
const obstacle = document.getElementById("obstacle");
const scoreText = document.getElementById("score");

let carLeft = 125;
let score = 0;

document.addEventListener("keydown", (e) => {
    if (e.key === "ArrowLeft" && carLeft > 0) {
        carLeft -= 25;
    }

    if (e.key === "ArrowRight" && carLeft < 250) {
        carLeft += 25;
    }

    car.style.left = carLeft + "px";
});

function moveObstacle() {
    let topPos = -100;

    obstacle.style.left =
        Math.floor(Math.random() * 250) + "px";

    const interval = setInterval(() => {
        topPos += 5;
        obstacle.style.top = topPos + "px";

        let obstacleLeft = parseInt(obstacle.style.left);

        if (
            topPos > 490 &&
            topPos < 590 &&
            Math.abs(obstacleLeft - carLeft) < 50
        ) {
            alert("Game Over! Score: " + score);
            location.reload();
        }

        if (topPos > 600) {
            clearInterval(interval);
            score++;
            scoreText.innerText = "Score: " + score;
            moveObstacle();
        }
    }, 20);
}

moveObstacle();